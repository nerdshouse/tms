rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Attachments: any authenticated user can upload; anyone can download
    match /attachments/{uid}/{allPaths=**} {
      allow read:  if true;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024; // 10 MB limit
    }
  }
}
